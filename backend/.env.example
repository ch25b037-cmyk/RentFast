# CampusLend backend environment — COPY to backend/.env and edit. Never commit backend/.env.
# Every variable here must also be declared in app/core/config.py (verify.py checks this).

# --- App ---
APP_NAME=CampusLend
APP_ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# --- Security (generate a real value: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
SECRET_KEY=change-me-dev-only-not-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false              # must be true in prod
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173   # comma-separated; never "*" in prod

# --- Database ---
DATABASE_URL=sqlite:///./campuslend.db   # prod example: postgresql+psycopg://user:pass@host:5432/campuslend

# --- Sign-in / OTP ---
ALLOWED_EMAIL_DOMAINS=smail.iitm.ac.in      # IIT Madras student email domain(s)
ADMIN_EMAILS=                             # comma-separated emails that become admins on first sign-in
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_HOUR=5

# --- Mail ---
MAIL_BACKEND=console             # console (prints OTP in dev) | smtp
MAIL_FROM=no-reply@smail.iitm.ac.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Loan safety ---
HANDOVER_CODE_TTL_MINUTES=10
CODE_MAX_ATTEMPTS=5
RETURN_CLAIM_AUTO_ACCEPT_HOURS=24
LOAN_AUTO_CLOSE_HOURS=48
AGREEMENT_VERSION=1
MAX_OPEN_REQUESTS_MEMBER=2
MAX_OPEN_REQUESTS_TRUSTED=5
MAX_ACTIVE_LOANS_MEMBER=1
MAX_ACTIVE_LOANS_TRUSTED=3
NEW_BORROWER_LOW_VALUE_LOANS=3   # first N loans limited to low-value items

# --- Trust score weights (see docs/SAFETY_SPEC.md §3) ---
TRUST_START=50
TRUST_ON_TIME=4
TRUST_LATE=-8
TRUST_REPORT_UPHELD=-15
TRUST_DISPUTE_LOST=-25
TRUST_DISPUTE_WON=5
TRUST_TIER_RESTRICTED_BELOW=30
TRUST_TIER_TRUSTED_FROM=70

# --- Rate limits (requests per minute unless stated) ---
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_WRITE_PER_MIN=30
RATE_LIMIT_READ_PER_MIN=120

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
